RIVER_MODEL=/app/weights/river_floater.pt
RIVER_CONFIDENCE=0.3
RIVER_IMAGE_SIZE=640
RIVER_CAMERA_AUTOSTART=false
RIVER_CAMERA_SOURCE=0
RIVER_CAMERA_LOCATION=河段 A
RIVER_CAMERA_INTERVAL=8
RIVER_AUTH_ENABLED=true
RIVER_ADMIN_USERNAME=admin
# 部署前务必修改为自己的强密码。
RIVER_ADMIN_PASSWORD=ChangeThisToAStrongPassword
# 部署前填写随机长字符串，例如：openssl rand -hex 32
RIVER_SESSION_SECRET=change-this-session-secret-before-production
# 当前使用 Cloudflare HTTPS 时可设为 true；若还要直接通过 http://公网IP 访问则保持 false。
RIVER_SESSION_HTTPS_ONLY=false
